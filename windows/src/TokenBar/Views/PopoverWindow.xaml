<Window x:Class="TokenBar.Views.PopoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TokenBar" Width="330" MaxHeight="520" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize">
    <Border Background="#F9FAFB" CornerRadius="12" BorderBrush="#D1D5DB" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="4" Opacity="0.2"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#FFFFFF" Padding="14,10" CornerRadius="12,12,0,0" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="24" Height="24" Background="#EFF6FF" CornerRadius="6" Margin="0,0,8,0">
                            <TextBlock Text="⚡" FontSize="13" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="TokenBar" FontWeight="Bold" FontSize="13" Foreground="#111827"/>
                            <TextBlock x:Name="TxtSubtitle" Text="模型额度监控" FontSize="9" Foreground="#6B7280"/>
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="BtnRefresh" Content="刷新" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Padding="10,4" Background="#F3F4F6" BorderBrush="#D1D5DB"
                            FontSize="11" Cursor="Hand" Click="BtnRefresh_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </DockPanel>
            </Border>

            <!-- Body: List of Provider Cards -->
            <ScrollViewer Grid.Row="1" MaxHeight="420" VerticalScrollBarVisibility="Auto" Margin="0,4,0,4">
                <StackPanel x:Name="PnlCards" Margin="12,4" />
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#F3F4F6" Padding="14,8" CornerRadius="0,0,12,12" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
                <DockPanel>
                    <TextBlock x:Name="TxtFooter" Text="准备就绪" FontSize="10" Foreground="#6B7280" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnSettings" Content="⚙" Width="26" Height="26" Margin="0,0,6,0"
                                Background="Transparent" BorderThickness="0" FontSize="13" Foreground="#4B5563"
                                Cursor="Hand" Click="BtnSettings_Click" ToolTip="偏好设置... / Settings"/>
                        <Button x:Name="BtnClose" Content="✕" Width="26" Height="26"
                                Background="Transparent" BorderThickness="0" FontSize="12" Foreground="#9CA3AF"
                                Cursor="Hand" Click="BtnClose_Click" ToolTip="关闭浮窗 / Close"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
