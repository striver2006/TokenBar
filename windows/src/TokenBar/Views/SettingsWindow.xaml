                                            <ComboBoxItem Tag="international" Content="international（alibabacloud.com）"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <TextBlock x:Name="TxtAliyunBalanceThresholdLabel" TextWrapping="Wrap" Text="账户余额提醒阈值:" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtAliyunBalanceThreshold" Width="120" HorizontalAlignment="Left" Margin="0,0,0,10" Padding="6"/>

