                                <Button x:Name="BtnOpenRamConsole" Content="前往 RAM 控制台创建" Padding="10,6" HorizontalAlignment="Left" Background="#FFFFFF" BorderBrush="#93C5FD" Foreground="#1D4ED8" Margin="0,0,0,10" Click="BtnOpenRamConsole_Click"/>

