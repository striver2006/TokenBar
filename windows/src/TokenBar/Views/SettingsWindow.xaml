<Window x:Class="TokenBar.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TokenBar - Settings" Height="480" Width="600"
        WindowStartupLocation="CenterScreen" Background="#F9FAFB">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="TokenBar - 设置 / Settings" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

        <TabControl Grid.Row="1" Background="White" BorderBrush="#E5E7EB">
            <TabItem Header="General / 通用">
                <StackPanel Margin="16">
                    <TextBlock Text="Language / 界面语言:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CmbLanguage" Width="200" HorizontalAlignment="Left" Margin="0,0,0,16" SelectionChanged="CmbLanguage_SelectionChanged">
                        <ComboBoxItem Content="跟随系统 / System"/>
                        <ComboBoxItem Content="简体中文"/>
                        <ComboBoxItem Content="English"/>
                    </ComboBox>

                    <TextBlock Text="Refresh Interval / 刷新间隔 (分钟):" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtInterval" Width="100" HorizontalAlignment="Left" Margin="0,0,0,16" Text="5"/>

                    <CheckBox x:Name="ChkHover" Content="Hover preview / 鼠标悬停预览" Margin="0,0,0,10" IsChecked="True"/>
                    <CheckBox x:Name="ChkLaunchAtLogin" Content="Launch at login / 开机自启动" Margin="0,0,0,10"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="OpenAI">
                <StackPanel Margin="16">
                    <CheckBox x:Name="ChkOpenAI" Content="启用 OpenAI 监控" Margin="0,0,0,12" FontWeight="Bold"/>
                    <TextBlock Text="OpenAI API Key:" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="TxtOpenAIKey" Margin="0,0,0,12"/>
                    <TextBlock Text="API Endpoint:" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtOpenAIEndpoint" Text="https://api.openai.com/v1" Margin="0,0,0,12"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Claude (Anthropic)">
                <StackPanel Margin="16">
                    <CheckBox x:Name="ChkClaude" Content="启用 Claude / Anthropic 监控" Margin="0,0,0,12" FontWeight="Bold" IsChecked="True"/>
                    <TextBlock Text="Anthropic API Key:" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="TxtAnthropicKey" Margin="0,0,0,12"/>
                    <TextBlock Text="Claude Code Token / Session:" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="TxtClaudeToken" Margin="0,0,0,12"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="TxtAbout" Text="TokenBar v1.0.0 • 模型额度监控" Foreground="#6B7280" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save / 保存" Width="90" Height="28" Margin="0,0,8,0" Background="#2563EB" Foreground="White" Click="BtnSave_Click"/>
                <Button Content="Close / 关闭" Width="80" Height="28" Click="BtnClose_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
