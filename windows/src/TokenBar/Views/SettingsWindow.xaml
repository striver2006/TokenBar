<Window x:Class="TokenBar.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TokenBar - Settings" Height="620" Width="840"
        WindowStartupLocation="CenterScreen" Background="#F9FAFB" MinWidth="700" MinHeight="550">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Two column layout: Left Navigation, Right Form -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Navigation Sidebar -->
            <Border Grid.Column="0" Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="16,14,16,12" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="26" Height="26" Background="#EFF6FF" CornerRadius="6" Margin="0,0,10,0">
                                <TextBlock Text="⚡" FontSize="14" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="TokenBar" FontWeight="Bold" FontSize="14" Foreground="#111827"/>
                                <TextBlock x:Name="TxtNavSubtitle" Text="偏好设置" FontSize="10" Foreground="#6B7280"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ListBox x:Name="LstNavigation" BorderThickness="0" Background="Transparent"
                             Margin="8,8,8,8" SelectionChanged="LstNavigation_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#E5E7EB"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#E0E7FF"/>
                                                    <Setter Property="Foreground" Value="#1D4ED8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBoxItem Tag="0">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="NavIconOpenAI" Width="12" Height="12" Stretch="Uniform" Fill="#9CA3AF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtNavOpenAI" Text="OpenAI" FontWeight="Medium" FontSize="12"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="1">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="NavIconClaude" Width="12" Height="12" Stretch="Uniform" Fill="#9CA3AF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtNavClaude" Text="Anthropic (Claude)" FontWeight="Medium" FontSize="12"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="2">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="NavIconGemini" Width="12" Height="12" Stretch="Uniform" Fill="#9CA3AF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtNavGemini" Text="Google Gemini" FontWeight="Medium" FontSize="12"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="3">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="NavIconDeepSeek" Width="12" Height="12" Stretch="Uniform" Fill="#9CA3AF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtNavDeepSeek" Text="DeepSeek (深度求索)" FontWeight="Medium" FontSize="12"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="4">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="NavIconVolcengine" Width="12" Height="12" Stretch="Uniform" Fill="#9CA3AF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtNavVolcengine" Text="火山方舟 (字节跳动)" FontWeight="Medium" FontSize="12"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="5">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="NavIconKimi" Width="12" Height="12" Stretch="Uniform" Fill="#9CA3AF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtNavKimi" Text="KIMI (月之暗面)" FontWeight="Medium" FontSize="12"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="6">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="NavIconOpenRouter" Width="12" Height="12" Stretch="Uniform" Fill="#9CA3AF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtNavOpenRouter" Text="OpenRouter" FontWeight="Medium" FontSize="12"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="7">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="NavIconGLM" Width="12" Height="12" Stretch="Uniform" Fill="#9CA3AF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtNavGLM" Text="GLM (智谱清言)" FontWeight="Medium" FontSize="12"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="8">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="NavIconAliyun" Width="12" Height="12" Stretch="Uniform" Fill="#9CA3AF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtNavAliyun" Text="阿里云百炼" FontWeight="Medium" FontSize="12"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="9">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="NavIconCustom" Width="12" Height="12" Stretch="Uniform" Fill="#9CA3AF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtNavCustom" Text="国内厂商 / 自定义" FontWeight="Medium" FontSize="12"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="10">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="NavIconDisplayOrder" Width="12" Height="12" Stretch="Uniform" Fill="#9CA3AF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtNavDisplayOrder" Text="显示顺序" FontWeight="Medium" FontSize="12"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="11">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="NavIconGeneral" Width="12" Height="12" Stretch="Uniform" Fill="#9CA3AF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtNavGeneral" Text="通用设置" FontWeight="Medium" FontSize="12"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Right Content Area -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 凭据管理器不可用 / 写入失败：所有厂商的 Key 都受影响，故置于全部选项卡之上 -->
                <Border x:Name="BdrSecretStoreWarning" Grid.Row="0" Background="#FEF3C7"
                        BorderBrush="#FCD34D" BorderThickness="0,0,0,1" Padding="20,10" Visibility="Collapsed">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Left" Text="⚠" FontSize="13" Foreground="#D97706"
                                   Margin="0,0,8,0" VerticalAlignment="Top"/>
                        <TextBlock x:Name="TxtSecretStoreWarning" TextWrapping="Wrap" FontSize="11" Foreground="#92400E"/>
                    </DockPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="#FFFFFF">
                <Grid Margin="24,20">
                    <!-- Tab 0: OpenAI -->
                    <!-- Tab 0: OpenAI -->
                    <StackPanel x:Name="PnlOpenAI" Visibility="Visible">
                        <DockPanel Margin="0,0,0,16">
                            <CheckBox x:Name="ChkOpenAIEnabled" Content="启用监控" DockPanel.Dock="Right" VerticalAlignment="Center" FontWeight="SemiBold" Margin="12,0,0,0"/>
                            <Path x:Name="IconOpenAI" Width="20" Height="20" Stretch="Uniform" Fill="#9CA3AF" Margin="0,0,8,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <StackPanel>
                                <TextBlock x:Name="TxtOpenAITitle" TextWrapping="Wrap" Text="OpenAI API 授权" FontSize="16" FontWeight="Bold" Foreground="#111827"/>
                                <TextBlock x:Name="TxtOpenAISubtitle" TextWrapping="Wrap" Text="配置官方或代理 API KEY，监控 TPM/RPM 速率限制与可用模型" FontSize="11" Foreground="#6B7280" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- Status Card -->
                        <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                            <DockPanel>
                                <TextBlock x:Name="TxtOpenAIStatusDot" TextWrapping="Wrap" Text="●" Foreground="#F59E0B" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtOpenAIStatus" TextWrapping="Wrap" Text="" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtOpenAIAccount" TextWrapping="Wrap" Text="" FontSize="11" Foreground="#6B7280" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <TextBlock x:Name="TxtOpenAIKeyLabel" TextWrapping="Wrap" Text="OpenAI API KEY" FontWeight="Medium" FontSize="12" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtOpenAIKey" Margin="0,0,0,4" Padding="6"/>
                        <TextBlock x:Name="TxtOpenAIKeyHint" TextWrapping="Wrap" Text="可在 OpenAI Platform (platform.openai.com) -> API Keys 中生成。" FontSize="10" Foreground="#6B7280" Margin="0,0,0,14"/>

                        <TextBlock x:Name="TxtOpenAIEndpointLabel" TextWrapping="Wrap" Text="API 接入端点" FontWeight="Medium" FontSize="12" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtOpenAIEndpoint" Text="https://api.openai.com/v1" Margin="0,0,0,4" Padding="6"/>
                        <TextBlock x:Name="TxtOpenAIEndpointHint" TextWrapping="Wrap" Text="默认为官方接口，亦可配置中转反向代理地址。" FontSize="10" Foreground="#6B7280" Margin="0,0,0,14"/>

                        <TextBlock x:Name="TxtOpenAIOrgIdLabel" TextWrapping="Wrap" Text="组织 ID (OpenAI-Organization, 可选)" FontWeight="Medium" FontSize="12" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtOpenAIOrgId" Margin="0,0,0,18" Padding="6"/>

                        <Button x:Name="BtnTestOpenAI" Content="保存并测试连接" Width="140" Height="32" HorizontalAlignment="Left"
                                Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnTestOpenAI_Click"/>
                    </StackPanel>

                    <!-- Tab 1: Anthropic -->
                    <StackPanel x:Name="PnlAnthropic" Visibility="Collapsed">
                        <DockPanel Margin="0,0,0,16">
                            <CheckBox x:Name="ChkClaudeEnabled" Content="启用监控" DockPanel.Dock="Right" VerticalAlignment="Center" FontWeight="SemiBold" Margin="12,0,0,0"/>
                            <Path x:Name="IconAnthropic" Width="20" Height="20" Stretch="Uniform" Fill="#9CA3AF" Margin="0,0,8,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <StackPanel>
                                <TextBlock x:Name="TxtClaudeTitle" TextWrapping="Wrap" Text="Anthropic (Claude) 统一授权" FontSize="16" FontWeight="Bold" Foreground="#111827"/>
                                <TextBlock x:Name="TxtClaudeSubtitle" TextWrapping="Wrap" Text="同时支持 Anthropic API Key (官方/代理) 与 Claude Code 订阅授权 (网页/本地)" FontSize="11" Foreground="#6B7280" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                            <DockPanel>
                                <TextBlock x:Name="TxtClaudeStatusDot" TextWrapping="Wrap" Text="●" Foreground="#F59E0B" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtClaudeStatus" TextWrapping="Wrap" Text="" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtClaudeAccount" TextWrapping="Wrap" Text="" FontSize="11" Foreground="#6B7280" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <!-- Method 1: API Key -->
                        <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock x:Name="TxtClaudeMethod1Title" TextWrapping="Wrap" Text="方式一：Anthropic API Key (官方或代理)" FontWeight="Bold" FontSize="12" Margin="0,0,0,10"/>
                                <TextBlock x:Name="TxtAnthropicKeyLabel" TextWrapping="Wrap" Text="API KEY:" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtAnthropicKey" Margin="0,0,0,8" Padding="6"/>
                                <TextBlock x:Name="TxtAnthropicEndpointLabel" TextWrapping="Wrap" Text="接入端点:" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtAnthropicEndpoint" Text="https://api.anthropic.com/v1" Margin="0,0,0,10" Padding="6"/>
                                <Button x:Name="BtnTestAnthropicKey" Content="保存并测试 API Key" Width="140" Height="28" HorizontalAlignment="Left" Background="#F3F4F6" BorderBrush="#D1D5DB" Click="BtnTestAnthropicKey_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Method 2: Claude Code CLI -->
                        <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <TextBlock x:Name="TxtClaudeMethod2Title" TextWrapping="Wrap" Text="方式二：Claude Code 订阅 (监控 5小时与每周额度)" FontWeight="Bold" FontSize="12" Margin="0,0,0,10"/>
                                <WrapPanel Margin="0,0,0,10">
                                    <Button x:Name="BtnImportClaudeLocal" Content="读取本地 CLI 授权 (~/.claude.json)" Padding="10,6" Background="#EFF6FF" BorderBrush="#93C5FD" Foreground="#1D4ED8" Margin="0,0,8,0" Click="BtnImportClaudeLocal_Click"/>
                                </WrapPanel>
                                <TextBlock x:Name="TxtClaudeManualTokenLabel" TextWrapping="Wrap" Text="手动输入 OAuth Token / Session (备用):" FontSize="11" Margin="0,0,0,4"/>
                                <DockPanel>
                                    <Button x:Name="BtnSaveClaudeToken" Content="保存" Width="70" DockPanel.Dock="Right" Margin="8,0,0,0" Click="BtnSaveClaudeToken_Click"/>
                                    <TextBox x:Name="TxtClaudeToken" Padding="6"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Tab 2: Gemini -->
                    <StackPanel x:Name="PnlGemini" Visibility="Collapsed">
                        <DockPanel Margin="0,0,0,16">
                            <CheckBox x:Name="ChkGeminiEnabled" Content="启用监控" DockPanel.Dock="Right" VerticalAlignment="Center" FontWeight="SemiBold" Margin="12,0,0,0"/>
                            <Path x:Name="IconGemini" Width="20" Height="20" Stretch="Uniform" Fill="#9CA3AF" Margin="0,0,8,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <StackPanel>
                                <TextBlock x:Name="TxtGeminiTitle" TextWrapping="Wrap" Text="Google Gemini 授权" FontSize="16" FontWeight="Bold" Foreground="#111827"/>
                                <TextBlock x:Name="TxtGeminiSubtitle" TextWrapping="Wrap" Text="支持 Google AI Studio API Key (永久有效) 或 Google 账号本地凭证" FontSize="11" Foreground="#6B7280" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                            <DockPanel>
                                <TextBlock x:Name="TxtGeminiStatusDot" TextWrapping="Wrap" Text="●" Foreground="#F59E0B" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtGeminiStatus" TextWrapping="Wrap" Text="" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtGeminiAccount" TextWrapping="Wrap" Text="" FontSize="11" Foreground="#6B7280" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock x:Name="TxtGeminiMethod1Title" TextWrapping="Wrap" Text="方式一：Google AI Studio API Key (推荐，永久有效)" FontWeight="Bold" FontSize="12" Margin="0,0,0,10" Foreground="#16A34A"/>
                                <TextBlock x:Name="TxtGeminiKeyLabel" TextWrapping="Wrap" Text="API Key (AIzaSy...):" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtGeminiKey" Margin="0,0,0,8" Padding="6"/>
                                <TextBlock x:Name="TxtGeminiEndpointLabel" TextWrapping="Wrap" Text="API 接入端点:" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtGeminiEndpoint" Text="https://generativelanguage.googleapis.com" Margin="0,0,0,10" Padding="6"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnTestGeminiKey" Content="保存并测试连接" Width="130" Height="28" Background="#2563EB" Foreground="White" BorderThickness="0" Margin="0,0,8,0" Click="BtnTestGeminiKey_Click"/>
                                    <Button x:Name="BtnClearGeminiKey" Content="清除 Key" Width="90" Height="28" Background="#F3F4F6" BorderBrush="#D1D5DB" Click="BtnClearGeminiKey_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <TextBlock x:Name="TxtGeminiMethod2Title" TextWrapping="Wrap" Text="方式二：Google 账号授权 / 本地凭证 (Google One / Antigravity)" FontWeight="Bold" FontSize="12" Margin="0,0,0,10"/>
                                <WrapPanel Margin="0,0,0,10">
                                    <Button x:Name="BtnGeminiWebLogin" Content="Google 网站登录授权" Padding="12,6" Background="#2563EB" Foreground="White" BorderThickness="0" Margin="0,0,8,0" Click="BtnGeminiWebLogin_Click"/>
                                    <Button x:Name="BtnImportGeminiLocal" Content="读取本地 Gemini / Antigravity 配置" Padding="10,6" Background="#EFF6FF" BorderBrush="#93C5FD" Foreground="#1D4ED8" Click="BtnImportGeminiLocal_Click"/>
                                </WrapPanel>
                                <TextBlock x:Name="TxtGeminiManualTokenLabel" TextWrapping="Wrap" Text="手动输入 Access Token (可选):" FontSize="11" Margin="0,0,0,4"/>
                                <DockPanel>
                                    <Button x:Name="BtnSaveGeminiToken" Content="保存" Width="70" DockPanel.Dock="Right" Margin="8,0,0,0" Click="BtnSaveGeminiToken_Click"/>
                                    <TextBox x:Name="TxtGeminiToken" Padding="6"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Tab 3: DeepSeek -->
                    <StackPanel x:Name="PnlDeepSeek" Visibility="Collapsed">
                        <DockPanel Margin="0,0,0,16">
                            <CheckBox x:Name="ChkDeepSeekEnabled" Content="启用监控" DockPanel.Dock="Right" VerticalAlignment="Center" FontWeight="SemiBold" Margin="12,0,0,0"/>
                            <Path x:Name="IconDeepSeek" Width="20" Height="20" Stretch="Uniform" Fill="#9CA3AF" Margin="0,0,8,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <StackPanel>
                                <TextBlock x:Name="TxtDeepSeekTitle" TextWrapping="Wrap" Text="DeepSeek (深度求索) 授权" FontSize="16" FontWeight="Bold" Foreground="#111827"/>
                                <TextBlock x:Name="TxtDeepSeekSubtitle" TextWrapping="Wrap" Text="配置 DeepSeek API Key，自动查询账户可用余额与 TPM/RPM 速率限制" FontSize="11" Foreground="#6B7280" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                            <DockPanel>
                                <TextBlock x:Name="TxtDeepSeekStatusDot" TextWrapping="Wrap" Text="●" Foreground="#F59E0B" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtDeepSeekStatus" TextWrapping="Wrap" Text="" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtDeepSeekAccount" TextWrapping="Wrap" Text="" FontSize="11" Foreground="#6B7280" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <TextBlock x:Name="TxtDeepSeekKeyLabel" TextWrapping="Wrap" Text="DeepSeek API KEY" FontWeight="Medium" FontSize="12" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtDeepSeekKey" Margin="0,0,0,4" Padding="6"/>
                        <TextBlock x:Name="TxtDeepSeekKeyHint" TextWrapping="Wrap" Text="可在 DeepSeek 开放平台 (platform.deepseek.com) -> API Keys 生成。" FontSize="10" Foreground="#6B7280" Margin="0,0,0,14"/>

                        <TextBlock x:Name="TxtDeepSeekEndpointLabel" TextWrapping="Wrap" Text="API 接入端点" FontWeight="Medium" FontSize="12" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtDeepSeekEndpoint" Text="https://api.deepseek.com/v1" Margin="0,0,0,14" Padding="6"/>

                        <TextBlock x:Name="TxtDeepSeekModelLabel" TextWrapping="Wrap" Text="默认模型名称" FontWeight="Medium" FontSize="12" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtDeepSeekModel" Text="deepseek-chat" Margin="0,0,0,14" Padding="6"/>

                        <TextBlock x:Name="TxtDeepSeekThresholdLabel" TextWrapping="Wrap" Text="余额提醒阈值 (按账户币种)" FontWeight="Medium" FontSize="12" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtDeepSeekThreshold" Text="10" Margin="0,0,0,4" Padding="6"/>
                        <TextBlock x:Name="TxtDeepSeekThresholdHint" TextWrapping="Wrap" Text="余额低于该值时托盘气泡提醒，并在额度卡片中变为橙/红色。" FontSize="10" Foreground="#6B7280" Margin="0,0,0,14"/>

                        <Button x:Name="BtnTestDeepSeek" Content="保存并测试连接" Width="140" Height="32" HorizontalAlignment="Left" Background="#2563EB" Foreground="White" BorderThickness="0" Click="BtnTestDeepSeek_Click"/>
                    </StackPanel>

                    <!-- Tab 4: Volcengine -->
                    <StackPanel x:Name="PnlVolcengine" Visibility="Collapsed">
                        <DockPanel Margin="0,0,0,16">
                            <CheckBox x:Name="ChkVolcengineEnabled" Content="启用监控" DockPanel.Dock="Right" VerticalAlignment="Center" FontWeight="SemiBold" Margin="12,0,0,0"/>
                            <Path x:Name="IconVolcengine" Width="20" Height="20" Stretch="Uniform" Fill="#9CA3AF" Margin="0,0,8,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <StackPanel>
