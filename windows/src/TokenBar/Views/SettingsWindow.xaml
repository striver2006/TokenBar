                                        <TextBlock x:Name="TxtAliyunSwitchAgentHint" TextWrapping="Wrap" FontSize="10" Foreground="#6B7280" Margin="0,0,0,10"/>
                                        <CheckBox x:Name="ChkAliyunReuseCliConfig" Content="复用本机百炼 CLI 的登录凭证" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="TxtAliyunReuseCliHint" TextWrapping="Wrap" FontSize="10" Foreground="#6B7280"/>
                                    </StackPanel>
                                </Expander>

                                <Button x:Name="BtnTestAliyunAK" Content="保存并测试 AccessKey 通道" Padding="12,6" HorizontalAlignment="Left" Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnTestAliyunAK_Click"/>
