                                <PasswordBox x:Name="PwdAliyunAkSecret" Margin="0,0,0,4" Padding="6"/>
                                <!-- 读取状态提示：Loading 时禁用输入框，Unavailable 时给出橙色警告 +
                                     重试入口。空输入框在 Unavailable 下不代表「没有」，保存不会删除。 -->
                                <TextBlock x:Name="TxtAliyunSecretHint" TextWrapping="Wrap" FontSize="10"
                                           Foreground="#6B7280" Margin="0,0,0,6" Visibility="Collapsed"/>
