                                <TextBlock x:Name="TxtCustomEndpointLabel" TextWrapping="Wrap" Text="API 接入端点 (Base URL):" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtCustomEndpoint" Margin="0,0,0,10" Padding="6"/>

                                <TextBlock x:Name="TxtCustomModelLabel" TextWrapping="Wrap" Text="默认模型名称 (选填):" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtCustomModel" Margin="0,0,0,10" Padding="6"/>

                                <TextBlock x:Name="TxtCustomThresholdLabel" TextWrapping="Wrap" Text="余额提醒阈值 (选填，按账户币种):" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtCustomThreshold" Margin="0,0,0,10" Padding="6"/>

                                <TextBlock x:Name="TxtCustomCookieLabel" TextWrapping="Wrap" Text="控制台 Cookie (选填)" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtCustomCookie" Margin="0,0,0,4" Padding="6"/>
                                <TextBlock x:Name="TxtCustomCookieHint" TextWrapping="Wrap" Text="小米 MiMo 等厂商的余额与套餐用量查询需要官网登录态。" FontSize="10" Foreground="#6B7280" Margin="0,0,0,14"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="BtnCancelCustomForm" Content="取消" Width="70" Height="28" Margin="0,0,8,0" Background="#F3F4F6" BorderBrush="#D1D5DB" Click="BtnCancelCustomForm_Click"/>
                                    <Button x:Name="BtnSaveCustomForm" Content="保存厂商" Width="90" Height="28" Background="#2563EB" Foreground="White" BorderThickness="0" Click="BtnSaveCustomForm_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Tab 10: Display Order -->
                    <StackPanel x:Name="PnlDisplayOrder" Visibility="Collapsed">
                        <DockPanel Margin="0,0,0,14">
                            <Button x:Name="BtnResetOrder" Content="恢复默认顺序" Padding="10,5" Background="#F3F4F6" BorderBrush="#D1D5DB" DockPanel.Dock="Right" VerticalAlignment="Center" Cursor="Hand" Click="BtnResetOrder_Click" Margin="12,0,0,0"/>
                            <Path x:Name="IconDisplayOrder" Width="20" Height="20" Stretch="Uniform" Fill="#9CA3AF" Margin="0,0,8,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <StackPanel>
                                <TextBlock x:Name="TxtDisplayOrderTitle" TextWrapping="Wrap" Text="显示顺序" FontSize="16" FontWeight="Bold" Foreground="#111827"/>
                                <TextBlock x:Name="TxtDisplayOrderSubtitle" TextWrapping="Wrap" Text="调整浮动框中各厂商余额卡片的先后顺序" FontSize="11" Foreground="#6B7280" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <TextBlock x:Name="TxtDisplayOrderHint" TextWrapping="Wrap" Text="使用上移 / 下移调整顺序，修改立即生效并自动保存；未列出的新启用厂商将排在末尾。" FontSize="11" Foreground="#6B7280" Margin="0,0,0,12"/>

                        <StackPanel x:Name="PnlOrderList"/>
                    </StackPanel>

                    <!-- Tab 11: General Settings -->
                    <StackPanel x:Name="PnlGeneral" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="IconGeneral" Width="20" Height="20" Stretch="Uniform" Fill="#9CA3AF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock x:Name="TxtGeneralTitle" TextWrapping="Wrap" Text="通用偏好设置" FontSize="16" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtGeneralSubtitle" TextWrapping="Wrap" Text="应用基础偏好与自启动配置" FontSize="11" Foreground="#6B7280" Margin="0,0,0,16"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="TxtLanguageLabel" TextWrapping="Wrap" Text="界面语言" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                                <ComboBox x:Name="CmbLanguage" Width="220" HorizontalAlignment="Left" Margin="0,0,0,16" SelectionChanged="CmbLanguage_SelectionChanged">
                                    <ComboBoxItem x:Name="CmbItemSystem" Content="跟随系统"/>
                                    <ComboBoxItem Content="简体中文"/>
                                    <ComboBoxItem Content="English"/>
                                </ComboBox>

                                <TextBlock x:Name="TxtIntervalLabel" TextWrapping="Wrap" Text="定期主动刷新周期" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                                <ComboBox x:Name="CmbInterval" Width="220" HorizontalAlignment="Left" Margin="0,0,0,16"/>

                                <CheckBox x:Name="ChkHoverPreview" Content="鼠标悬停自动显示小提示浮窗" FontSize="12" Margin="0,0,0,8" IsChecked="True"/>
                                <TextBlock x:Name="TxtHoverDesc" TextWrapping="Wrap" Text="鼠标移动到托盘图标上方时自动展示额度卡片" FontSize="10" Foreground="#6B7280" Margin="22,0,0,14"/>

                                <CheckBox x:Name="ChkLaunchAtLogin" Content="开机自动启动" FontSize="12" Margin="0,0,0,8"/>
                                <TextBlock x:Name="TxtLaunchDesc" TextWrapping="Wrap" Text="登录 Windows 时自动在系统托盘运行 TokenBar" FontSize="10" Foreground="#6B7280" Margin="22,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Bottom Footer Bar -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <TextBlock x:Name="TxtAppAboutFooter" Text="TokenBar v1.1.2 • 模型额度监控" FontSize="11" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnSaveAll" Content="保存全部设置" Width="110" Height="30" Margin="0,0,10,0" Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnSaveAll_Click"/>
                    <Button x:Name="BtnCloseWindow" Content="关闭" Width="70" Height="30" Background="#F3F4F6" BorderBrush="#D1D5DB" Cursor="Hand" Click="BtnClose_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
